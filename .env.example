# Supabase project URL, without trailing slash. The API validates user access tokens via public JWKS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Session pooler connection from Supabase Connect. Never place passwords inside this URL.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT
DB_PASSWORD=replace-with-database-password
DB_POOL_SIZE=5
PORT=8080
# Optional comma-separated exact web origins. Mobile native requests do not need CORS.
CORS_ORIGINS=http://localhost:3000
# Docker Compose local database only. It does not change the remote database password.
LOCAL_DB_PASSWORD=glicnote-local-only
# Host ports used by Docker Compose; the API always listens on 8080 inside its container.
API_PORT=8080
LOCAL_DB_PORT=5433

# Local Google OAuth (Web application); stored only by Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
